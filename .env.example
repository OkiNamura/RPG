# Ключ OpenRouter. Обязателен для ходов и картинок.
OPENROUTER_API_KEY=

# Модель ведущего (можно не указывать).
# OMIKA_MODEL=deepseek/deepseek-v4-flash-0731

# Адрес и порт. В Docker HOST=0.0.0.0; локально 127.0.0.1.
# HOST=127.0.0.1
# PORT=7801

# Включить вход по паролю. Если пусто — авторизация выключена (локально).
OMIKA_PASSWORD=

# Секрет для подписи cookie. Если пусто — берётся из пароля.
# OMIKA_SESSION_SECRET=

# Secure-cookie за HTTPS. Обычно определяется по X-Forwarded-Proto.
# OMIKA_SECURE_COOKIE=true

# Отключить запись трейсов (по умолчанию включены).
# OMIKA_TRACE=0

# Cloudflare Turnstile для входа (если включён, заменяет арифметическую капчу).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET=

# Локальный Qwen-Image через Unsloth Studio (опционально).
# UNSLOTH_API_KEY=
# UNSLOTH_BASE_URL=http://127.0.0.1:8888/v1
# UNSLOTH_IMAGE_MODEL=unsloth/Qwen-Image-2.1-Turbo-GGUF
# UNSLOTH_GGUF=qwen-image-2.1-turbo-Q6_K.gguf

# Путь к Claude Code CLI для scripts/claude-review.mjs.
# Если пусто — скрипт ищет самый свежий claude.exe в Claude-Data.
# CLAUDE_BIN=C:\Users\User\AppData\Local\Claude-Data\...\claude.exe

