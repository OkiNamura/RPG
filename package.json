{
  "name": "omika",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Omika — текстовая RPG в браузере",
  "scripts": {
    "start": "node src/server.ts",
    "catalog": "node scripts/build-catalog.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "test": "node scripts/unit-test.mjs && node scripts/memory-test.mjs && node scripts/director-test.mjs && node scripts/world-test.mjs && node scripts/context-order-test.mjs",
    "test:ui": "node scripts/ui-test.mjs",
    "test:e2e": "node scripts/e2e-full.mjs",
    "test:a11y": "node scripts/a11y-test.mjs",
    "test:repeat": "node scripts/repetition-test.mjs",
    "test:world": "node scripts/world-test.mjs",
    "test:tone": "node scripts/tone-test.mjs",
    "test:context": "node scripts/context-test.mjs",
    "test:context-order": "node scripts/context-order-test.mjs",
    "test:memory": "node scripts/memory-test.mjs",
    "test:director": "node scripts/director-test.mjs",
    "test:action-repeat": "node scripts/action-repeat-test.mjs",
    "shot": "node scripts/shot.mjs",
    "playtest": "node scripts/playtest.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
